# Freqhub .gitignore
# This file uses a whitelist approach: exclude everything, then explicitly include what we need

# ============================================
# EXCLUDE EVERYTHING BY DEFAULT
# ============================================
*
.*
# Note: * excludes all files, .* explicitly excludes hidden files/directories

# ============================================
# EXPLICITLY INCLUDE ESSENTIAL FILES
# ============================================

# License file
!LICENSE

# Documentation
!README.md
!COPYRIGHT_HEADER.txt
!COPYRIGHT_GUIDE.md
!CODE_OF_CONDUCT.md
!TESTING.md

# ============================================
# SOURCE CODE (will be added as we create files)
# ============================================

# TypeScript/JavaScript source files
!frontend/
!frontend/**/*
!backend/
!backend/**/*
!src/
!src/**/*
!*.ts
!*.tsx
!*.js
!*.jsx

# Configuration files
!package.json
!package-lock.json
!pnpm-lock.yaml
!yarn.lock
!tsconfig.json
!tsconfig.*.json
!vite.config.ts
!vite.config.js
!.eslintrc.*
!eslint.config.*
!.prettierrc.*
!.prettierignore

# ============================================
# BUILD & DEPLOYMENT
# ============================================

# Build output (exclude)
dist/
build/
out/
*.tsbuildinfo

# Explicitly exclude dist directories in backend and frontend
backend/dist/
frontend/dist/

# ============================================
# DEPENDENCIES
# ============================================

# Dependencies (exclude)
node_modules/
.pnp
.pnp.js

# ============================================
# ENVIRONMENT & SECRETS
# ============================================

# Environment variables (exclude)
.env
.env.local
.env.*.local
!.env.example

# ============================================
# EDITOR & IDE
# ============================================

# Editor directories and files (exclude)
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store

# ============================================
# TESTING
# ============================================

# Test coverage (exclude)
coverage/
*.lcov
.nyc_output/

# ============================================
# LOGS
# ============================================

# Logs (exclude)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# TEMPORARY FILES
# ============================================

# Temporary files (exclude)
*.tmp
*.temp
.cache/
.parcel-cache/

# ============================================
# DOCKER
# ============================================

# Docker files (include)
!Dockerfile
!docker-compose.yml
!docker-compose.full.yml
!.dockerignore
!docker/
!docker/**/*

# ============================================
# EXAMPLES
# ============================================

# Examples directory (include)
!examples/
!examples/**/*

# Exclude sensitive files in examples
examples/**/.env
examples/**/secret.yaml
!examples/**/secret.yaml.example
!examples/**/.env.example

# Include Freqtrade data directories and configs (in examples/docker/)
!examples/docker/freqtrade-data-*/
!examples/docker/freqtrade-data-*/config.json
!examples/docker/freqtrade-data-*/strategies/
!examples/docker/freqtrade-data-*/strategies/*.py

# Exclude generated files inside freqtrade-data directories
examples/docker/freqtrade-data-*/*.db
examples/docker/freqtrade-data-*/*.sqlite
examples/docker/freqtrade-data-*/*.sqlite-shm
examples/docker/freqtrade-data-*/*.sqlite-wal
examples/docker/freqtrade-data-*/*.sqlite3
examples/docker/freqtrade-data-*/logs/
examples/docker/freqtrade-data-*/.freqtrade/
examples/docker/freqtrade-data-*/backtest_results/
examples/docker/freqtrade-data-*/hyperopt_results/
examples/docker/freqtrade-data-*/data/
examples/docker/freqtrade-data-*/plot/

# Valkey data in examples (exclude generated files, but include .keep)
examples/docker/valkey-data/*.aof
examples/docker/valkey-data/appendonly.aof
examples/docker/valkey-data/dump.rdb
examples/docker/valkey-data/appendonlydir/
!examples/docker/valkey-data/.keep

# ============================================
# CI/CD
# ============================================

# CI/CD configuration (include)
!.github/
!.github/**/*
!.gitlab-ci.yml
!.travis.yml
!.circleci/

# ============================================
# PUBLIC ASSETS
# ============================================

# Public directory (include when created)
!public/
!public/**/*

# ============================================
# HTML & STATIC FILES
# ============================================

# HTML entry point (include)
!index.html
!frontend/index.html

# ============================================
# GIT
# ============================================

# Git files (include)
!.gitignore
!.gitattributes
!.git/

# ============================================
# ADDITIONAL CONFIGURATION
# ============================================

# Nginx configuration (include when created)
!nginx.conf
!nginx.conf.template

# Scripts directory (include)
!scripts/
!scripts/**/*

# Shell scripts (include)
!*.sh

# ============================================
# DATABASE
# ============================================

# Exclude development databases
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
!backend/data/freqhub.db.example

# Valkey data files in backend/data (exclude AOF and RDB files)
backend/data/*.aof
backend/data/appendonly.aof
backend/data/dump.rdb
backend/data/appendonlydir/

# ============================================
# NOTE: As you add new files/directories to the project,
# add them to the whitelist above using the ! prefix
# ============================================

