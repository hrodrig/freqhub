# Freqhub .gitignore
# This file uses a whitelist approach: exclude everything, then explicitly include what we need

# ============================================
# EXCLUDE EVERYTHING BY DEFAULT
# ============================================
*
.*
# Note: * excludes all files, .* explicitly excludes hidden files/directories

# ============================================
# EXPLICITLY INCLUDE ESSENTIAL FILES
# ============================================
!Makefile

# License file
!LICENSE

# Documentation
!README.md
!COPYRIGHT_HEADER.txt
!COPYRIGHT_GUIDE.md
!CODE_OF_CONDUCT.md
!TESTING.md
!ENV_SETUP.md
!DONATIONS.md
!CHANGELOG.md

# ============================================
# SOURCE CODE (will be added as we create files)
# ============================================

# TypeScript/JavaScript source files
!frontend/
!frontend/**/*
!backend/
!backend/**/*
!config-service/
!config-service/**/*
!config-agent/
!config-agent/**/*
!src/
!src/**/*
!*.ts
!*.tsx
!*.js
!*.jsx

# Configuration files
!package.json
!package-lock.json
!pnpm-lock.yaml
!yarn.lock
!tsconfig.json
!tsconfig.*.json
!vite.config.ts
!vite.config.js
!.eslintrc.*
!eslint.config.*
!.prettierrc.*
!.prettierignore

# ============================================
# BUILD & DEPLOYMENT
# ============================================

# Build output (exclude)
dist/
build/
out/
*.tsbuildinfo

# Explicitly exclude dist directories in backend and frontend
backend/dist/
frontend/dist/

# ============================================
# DEPENDENCIES
# ============================================

# Dependencies (exclude)
node_modules/
.pnp
.pnp.js

# ============================================
# ENVIRONMENT & SECRETS
# ============================================

# Environment variables (exclude)
.env
.env.local
.env.*.local
!env.example

# ============================================
# EDITOR & IDE
# ============================================

# Editor directories and files (exclude)
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store

# ============================================
# TESTING
# ============================================

# Test coverage (exclude)
coverage/
*.lcov
.nyc_output/

# ============================================
# LOGS
# ============================================

# Logs (exclude)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# TEMPORARY FILES
# ============================================

# Temporary files (exclude)
*.tmp
*.temp
.cache/
.parcel-cache/

# ============================================
# DOCKER
# ============================================

# Docker files (include)
!Dockerfile
!docker-compose.yml
!docker-compose.full.yml
!docker-compose.published.yml
!.dockerignore
!docker/
!docker/**/*

# ============================================
# EXAMPLES
# ============================================

# Examples directory (include only selected files)
!examples/

# Allow documentation in examples
!examples/README.md
!examples/**/*.md

# Docker examples (allow compose/docs/scripts/config examples)
!examples/docker/
!examples/docker/README.md
!examples/docker/docker-compose*.yml
!examples/docker/env.example
!examples/docker/config.json.example
!examples/docker/setup.sh

# Kubernetes examples (allow manifests/docs explicitly)
!examples/kubernetes/
!examples/kubernetes/.keep
!examples/kubernetes/README.md
!examples/kubernetes/backend-egress-networkpolicy.yaml
!examples/kubernetes/backend-pvc.yaml
!examples/kubernetes/backend.yaml
!examples/kubernetes/frontend-nginx-configmap.yaml
!examples/kubernetes/frontend.yaml
!examples/kubernetes/ingressroute.example.yaml
!examples/kubernetes/valkey-configmap.yaml
!examples/kubernetes/valkey-pvc.yaml
!examples/kubernetes/valkey.yaml

# Keep only .keep inside example data directories
examples/docker/freqtrade-data-*/**
!examples/docker/freqtrade-data-*/.keep
examples/docker/freqhub-data/**
!examples/docker/freqhub-data/.keep
examples/docker/valkey-data/**
!examples/docker/valkey-data/.keep

# Exclude files starting with dot in examples (except .keep)
examples/**/.*
!examples/**/.keep
!examples/**/env.example

# Exclude sensitive files in examples (keep example secrets)
examples/**/secret.yaml
!examples/**/secret.yaml.example

# ============================================
# CI/CD
# ============================================

# CI/CD configuration (include)
!.github/
!.github/**/*
!.gitlab-ci.yml
!.travis.yml
!.circleci/

# ============================================
# PUBLIC ASSETS
# ============================================

# Public directory (include when created)
!public/
!public/**/*

# ============================================
# HTML & STATIC FILES
# ============================================

# HTML entry point (include)
!index.html
!frontend/index.html

# ============================================
# GIT
# ============================================

# Git files (include)
!.gitignore
!.gitattributes
!.git/

# ============================================
# ADDITIONAL CONFIGURATION
# ============================================

# Nginx configuration (include when created)
!nginx.conf
!nginx.conf.template

# Scripts directory (include)
!scripts/
!scripts/**/*

# Shell scripts (include)
!*.sh

# FreqHub CLI script (include)
!freqhub

# ============================================
# DATABASE
# ============================================

# Exclude development databases
backend/data/**/*
!backend/data/.keep
!backend/data/freqhub.db.example

# ============================================
# NOTE: As you add new files/directories to the project,
# add them to the whitelist above using the ! prefix
# ============================================

