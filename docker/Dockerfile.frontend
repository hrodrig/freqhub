FROM node:24-alpine AS builder

WORKDIR /app

# Copy package files
COPY frontend/package*.json ./
RUN npm install

# Copy source
COPY frontend/ ./

# Build arguments
ARG VITE_BASE_PATH=/
# VITE_API_PROXY_TARGET is optional - if not set, will use relative URL in production
# For development builds, you can pass: --build-arg VITE_API_PROXY_TARGET=http://localhost:3001
# Note: Do not set a default value here - leave it undefined so the code can use PROD fallback
ARG VITE_API_PROXY_TARGET

# Set environment variables
ENV VITE_BASE_PATH=${VITE_BASE_PATH}
# Only set VITE_API_PROXY_TARGET if it's provided (non-empty)
# If VITE_API_PROXY_TARGET is not provided, it will be undefined and the code will use PROD fallback
ENV VITE_API_PROXY_TARGET=${VITE_API_PROXY_TARGET}

# Build
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration template (for local development and Docker Compose)
# Default: points to localhost:3001
# In Kubernetes, this will be overridden by ConfigMap mount at /etc/nginx/conf.d
COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template

# Set environment variable for nginx template
ENV BASE_PATH=/

EXPOSE 80

# Copy template to conf.d for local development (default: localhost:3001)
# In Docker Compose: mount nginx.conf.docker-compose as volume to override
# In Kubernetes: ConfigMap will override this file
CMD ["/bin/sh", "-c", "if [ ! -f /etc/nginx/conf.d/default.conf ]; then cp /etc/nginx/templates/default.conf.template /etc/nginx/conf.d/default.conf; fi && nginx -g 'daemon off;'"]

