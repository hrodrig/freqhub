FROM node:18-alpine AS builder

WORKDIR /app

# Copy package files
COPY frontend/package*.json ./
RUN npm install

# Copy source
COPY frontend/ ./

# Build arguments
ARG VITE_BASE_PATH=/
# VITE_API_PROXY_TARGET is optional - if not set, will use relative URL in production
# For development builds, you can pass: --build-arg VITE_API_PROXY_TARGET=http://localhost:3001
ARG VITE_API_PROXY_TARGET=

# Set environment variables
ENV VITE_BASE_PATH=${VITE_BASE_PATH}
# Only set VITE_API_PROXY_TARGET if it's provided (non-empty)
# This allows the code to use import.meta.env.PROD fallback
ENV VITE_API_PROXY_TARGET=${VITE_API_PROXY_TARGET}

# Build
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template

# Set environment variable for nginx template
ENV BASE_PATH=/

EXPOSE 80

CMD ["/bin/sh", "-c", "cat /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]

