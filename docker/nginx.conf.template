# Rate limiting / connection limiting (HTTP context)
# Note: This file is included inside Nginx's `http { ... }` context.
limit_req_zone $binary_remote_addr zone=freqhub_api_limit:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=freqhub_conn_limit:10m;

server {
    listen       80;
    server_name  localhost;
    root         /usr/share/nginx/html;
    index        index.html;

    # Basic hardening
    server_tokens off;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    # Start with CSP in Report-Only mode to avoid breaking the SPA.
    # Tighten and enforce once validated in production.
    add_header Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https: wss:; upgrade-insecure-requests" always;

    # Proxy API requests to backend
    # Default: http://localhost:3001 (local development)
    # For Docker Compose: mount nginx.conf.docker-compose as volume to override
    # For Kubernetes: use frontend-nginx-configmap.yaml which points to freqhub-backend:3001
    location /api {
        # Apply rate limit to API only (do NOT apply to /socket.io to avoid breaking real-time updates)
        limit_req zone=freqhub_api_limit burst=40 nodelay;
        limit_req_status 429;

        proxy_pass http://localhost:3001;
        proxy_http_version 1.1;
        
        # Timeouts (increased for reliability)
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # Buffers - disable to stream responses immediately
        proxy_buffering off;
        proxy_request_buffering off;
        
        # Headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Proxy WebSocket connections (Socket.io)
    location /socket.io {
        proxy_pass http://localhost:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Limit concurrent connections per IP (includes websockets)
    limit_conn freqhub_conn_limit 20;

    # Static asset caching (avoid caching index.html)
    location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
    }

    # Base path configuration
    # For root path, use simple location
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Allow well-known paths (e.g., security.txt) but deny other dotfiles
    location ^~ /.well-known/ {
        allow all;
    }
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/json application/javascript;
}

