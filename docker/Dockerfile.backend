FROM node:24-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
RUN npm install

# Copy source
COPY . ./

# Build
RUN npm run build

# Production stage
FROM node:24-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
RUN npm install --only=production

# Copy built files
COPY --from=builder /app/dist ./dist

# Copy migrations directory (SQL files are not compiled, need to be copied separately)
COPY --from=builder /app/src/db/migrations ./dist/db/migrations

# Create data directory
RUN mkdir -p /app/data

EXPOSE 3001

CMD ["node", "dist/app.js"]

