# Freqtrade Docker Compose Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# API Server Credentials
# ============================================
# Username for Freqtrade API (same for all bots)
FREQTRADE_USERNAME=freqtrader

# Passwords for each bot's API
FREQTRADE_PASSWORD_1=SuperSecret1!
FREQTRADE_PASSWORD_2=SuperSecret2!
FREQTRADE_PASSWORD_3=SuperSecret3!

# JWT Secret Key (should be at least 32 characters, same for all bots)
FREQTRADE_JWT_SECRET=change-this-jwt-secret-key-in-production-min-32-chars

# ============================================
# Exchange Credentials (Binance)
# ============================================
# Exchange name (default: binance)
FREQTRADE_EXCHANGE_NAME=binance

# Binance API Key and Secret for each bot
# IMPORTANT: These are required for live trading!
# For dry-run mode, you can leave them empty
# Get your API keys from: https://www.binance.com/en/my/settings/api-management

# Bot 1 Exchange Credentials
FREQTRADE_EXCHANGE_KEY_1=your-binance-api-key-here
FREQTRADE_EXCHANGE_SECRET_1=your-binance-api-secret-here

# Bot 2 Exchange Credentials
FREQTRADE_EXCHANGE_KEY_2=your-binance-api-key-here
FREQTRADE_EXCHANGE_SECRET_2=your-binance-api-secret-here

# Bot 3 Exchange Credentials
FREQTRADE_EXCHANGE_KEY_3=your-binance-api-key-here
FREQTRADE_EXCHANGE_SECRET_3=your-binance-api-secret-here

# ============================================
# Trading Configuration
# ============================================
# Enable dry-run mode (true = paper trading, false = live trading)
# WARNING: Set to false only when you're ready for live trading!
FREQTRADE_DRY_RUN=true

# Starting wallet balance for dry-run mode
FREQTRADE_DRY_RUN_WALLET=1000

# Strategy names (optional, defaults to SampleStrategy)
FREQTRADE_STRATEGY_1=SampleStrategy
FREQTRADE_STRATEGY_2=SampleStrategy
FREQTRADE_STRATEGY_3=SampleStrategy
