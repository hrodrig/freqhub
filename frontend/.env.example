# FreqHub Frontend Environment Variables
# Copy this file to .env and adjust the values as needed

# Base Path Configuration
# For subdirectory deployments (e.g., /freqhub/), set this to the base path
# Default: / (root)
VITE_BASE_PATH=/

# API Proxy Target (Optional)
# In development, Vite proxy uses this to forward /api requests to the backend
# In production, leave empty to use relative URLs (Nginx will proxy)
# Default: http://localhost:3001 (for development)
VITE_API_PROXY_TARGET=http://localhost:3001
