# FreqHub Config Agent - Environment Configuration
# This agent runs as a sidecar next to each Freqtrade bot

# Server Configuration
PORT=3010

# Path to the bot's config.json (shared volume)
CONFIG_PATH=/freqtrade/user_data/config.json

# Bot API Configuration (for reload_config)
BOT_API_URL=http://localhost:8080
BOT_API_USERNAME=freqtrader
BOT_API_PASSWORD=

# Authentication
# API key to protect the agent endpoints
API_KEY=change-this-agent-api-key-min-32-characters

# Backup settings
BACKUP_ENABLED=true
BACKUP_COUNT=5

# Logging
LOG_LEVEL=info
