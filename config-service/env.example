# FreqHub Config Service - Environment Configuration
# Copy this file to .env and adjust values as needed

# Server Configuration
PORT=3005
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=freqhub_config

# FreqHub Backend Integration
FREQHUB_BACKEND_URL=http://localhost:3001
FREQHUB_BACKEND_API_KEY=change-this-api-key-in-production

# Security
API_KEY=change-this-config-service-api-key-min-32-chars

# Encryption for sensitive config fields (exchange keys, etc.)
ENCRYPTION_KEY=change-this-encryption-key-min-32-characters

# Logging
LOG_LEVEL=info

# Config Agent URLs (optional, for direct deploy)
# Format: botId=agentUrl,botId2=agentUrl2
# AGENT_URLS=bot1=http://agent1:3010,bot2=http://agent2:3010
