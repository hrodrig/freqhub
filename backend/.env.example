# FreqHub Backend Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development
BASE_PATH=

# Database
DATABASE_PATH=./data/freqhub.db

# Encryption
ENCRYPTION_KEY=change-this-encryption-key-min-32-characters-long-please

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Valkey Cache Configuration (Optional)
# Valkey is a Redis-compatible fork with BSD license, recommended for open-source projects
# Set VALKEY_ENABLED=true to enable caching (requires Valkey/Redis running)
VALKEY_ENABLED=false
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=  # Optional, leave empty for development

# Note: If VALKEY_ENABLED=false or Valkey is unavailable, the system automatically
# falls back to in-memory caching. This ensures the application works even without
# Valkey, though with reduced performance for multi-bot scenarios.

# Polling Service Configuration (Optional)
# Automatic background polling keeps bot data fresh in cache
# Set POLLING_ENABLED=false to disable automatic polling
POLLING_ENABLED=true
POLLING_INTERVAL=10000  # Polling interval in milliseconds (default: 10000 = 10 seconds)

# Rate Limiting Configuration (Optional)
# Protects Freqtrade APIs from being overwhelmed
# Set RATE_LIMIT_ENABLED=false to disable rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60  # Default requests per window (default: 60)
RATE_LIMIT_WINDOW=60  # Time window in seconds (default: 60)
